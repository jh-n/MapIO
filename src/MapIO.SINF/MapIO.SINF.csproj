<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net6.0</TargetFrameworks>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Version>1.0.1</Version>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE" Link="LICENSE" Pack="True" PackagePath="" />
    <None Include="..\..\docs\MapIO.SINF\README.md" Pack="True" PackagePath="" Condition="'$(MSBuildTarget)' == 'Pack'">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\docs\MapIO.SINF\README.md" Pack="True" PackagePath="" Condition="'$(MSBuildTarget)' != 'Pack'">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MapIO.Core" Version="1.0.3" Condition="'$(MSBuildTarget)' == 'Pack'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MapIO.Core\MapIO.Core.csproj" Condition="'$(MSBuildTarget)' != 'Pack'" />
  </ItemGroup>
  
</Project>
